POSTGRES_USER=pea
POSTGRES_PASSWORD=pea
POSTGRES_DB=pea_radar
DATABASE_URL=postgresql+psycopg://pea:pea@db:5432/pea_radar
TEST_DATABASE_URL=postgresql+psycopg://pea:pea@db:5432/pea_radar_test

# Chiffre la clé API Claude en base : une longue chaîne aléatoire, à ne pas changer ensuite
APP_SECRET=change-me
# Optionnel : clé API Claude (sinon, saisie dans les Réglages)
ANTHROPIC_API_KEY=

# Référencement : laisser à false en local (robots.txt interdit tout) ; true une fois le site en ligne
SEO_INDEXING=false
# Adresse publique du site, utilisée dans le sitemap, robots.txt et llms.txt
PUBLIC_BASE_URL=http://localhost:8095
