# HSTS seulement derrière HTTPS (HSTS_ENABLED=true dans .env) ; une valeur vide n'envoie pas l'en-tête.
map "${HSTS_ENABLED}" $hsts {
  "true"  "max-age=31536000; includeSubDomains";
  default "";
}

server {
  listen 80;
  root /usr/share/nginx/html;
  include /etc/nginx/security-headers.conf;

  gzip on;
  gzip_types text/css application/javascript application/json image/svg+xml application/xml text/markdown text/plain;
  gzip_comp_level 6;
  gzip_vary on;

  location /api/ {
    proxy_pass http://api:8000;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_buffering off;
    proxy_http_version 1.1;
    # la réflexion de Claude peut rester silencieuse plus de 60 s
    proxy_read_timeout 600s;
  }

  # Fichiers de référencement générés par l'API (robots.txt interdit tout tant que SEO_INDEXING=false)
  location = /robots.txt { proxy_pass http://api:8000/api/seo/robots.txt; }
  location = /sitemap.xml { proxy_pass http://api:8000/api/seo/sitemap.xml; }
  # Fichiers listés par l'index (pages, actions-1, etf-1, guide…)
  location ~ ^/sitemap-[a-z0-9-]+\.xml$ { proxy_pass http://api:8000/api/seo$uri; }
  location = /llms.txt { proxy_pass http://api:8000/api/seo/llms.txt; }

  # Guide utilisateur (/guide/) et documentation admin (/documentation/) : sites Docsify statiques
  # de public/, hors du routeur React, avec leurs fichiers communs dans /docsify/.
  # Guide et fichiers communs : publics. Documentation admin : nginx demande à l'API si la session
  # est admin (auth_request), sinon renvoie vers la connexion.
  # Redirection relative : le port publié (8095) n'est pas celui d'écoute de nginx (80).
  absolute_redirect off;
  location ~ ^/(guide|documentation)$ { return 301 /$1/; }
  location ~ ^/(guide|docsify)/ {
    default_type text/markdown;  # .md absent de mime.types
    charset utf-8;
    charset_types text/markdown text/css application/javascript;
    try_files $uri $uri/ =404;
  }
  location /documentation/ {
    auth_request /_admin_check;
    error_page 401 403 = @connexion_admin;
    add_header Cache-Control "no-store" always;
    include /etc/nginx/security-headers.conf;
    default_type text/markdown;
    charset utf-8;
    charset_types text/markdown text/css application/javascript;
    try_files $uri $uri/ =404;
  }
  location = /_admin_check {
    internal;
    proxy_pass http://api:8000/api/auth/admin-check;
    proxy_pass_request_body off;
    proxy_set_header Content-Length "";
    proxy_set_header X-Original-URI $request_uri;
  }
  location @connexion_admin {
    return 302 /connexion?suite=%2Fdocumentation%2F;
  }

  location /assets/ {
    expires 1y;
    add_header Cache-Control "public, immutable";
    include /etc/nginx/security-headers.conf;
  }

  # Gabarit lu par l'API pour composer les pages publiques (titre, description, résumé, données embarquées).
  location = /_spa/index.html {
    alias /usr/share/nginx/html/index.html;
    add_header Cache-Control "no-store" always;
    include /etc/nginx/security-headers.conf;
  }

  # Manifeste de Vite : l'API y lit le code de chaque page pour le précharger.
  location = /_spa/manifest.json {
    alias /usr/share/nginx/html/.vite/manifest.json;
    add_header Cache-Control "no-store" always;
    include /etc/nginx/security-headers.conf;
  }

  # Pages publiques : HTML complet préparé par l'API (référencement, premier affichage sans attendre l'API).
  # Si l'API ne répond pas, le index.html statique prend le relais (l'application fonctionne comme avant).
  location ~ ^/(explorer|etf|premium|cgu|cgv|confidentialite|mentions-legales|titres/[0-9]+)?$ {
    proxy_pass http://api:8000/api/seo/page?path=$uri;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_intercept_errors on;
    error_page 500 502 503 504 = @spa;
    include /etc/nginx/security-headers.conf;
  }
  location @spa {
    add_header Cache-Control "no-cache" always;
    include /etc/nginx/security-headers.conf;
    try_files /index.html =404;
  }

  location = /index.html {
    add_header Cache-Control "no-cache" always;
    include /etc/nginx/security-headers.conf;
  }

  location / {
    try_files $uri /index.html;
  }
}
